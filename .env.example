# Local prototype: SQLite, no setup required. Leave DATABASE_URL unset to
# use the default (sqlite:///./openloops.db inside backend/), or override
# it below (e.g. to point at a different file for a clean slate).
# DATABASE_URL=sqlite:///./openloops.db

# Future: once the concept is validated, this becomes a postgresql://
# connection string (Supabase, Neon, or Railway — undecided). See
# docs/DECISIONS.md.

# Frontend
VITE_API_BASE_URL=http://localhost:8000
